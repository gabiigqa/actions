{
  "name": "api-partner",
  "version": "1.0.0",
  "main": "src/preloader.js",
  "scripts": {
    "prebuild:prod": "npm ci --include=dev",
    "prebuild": "",
    "build:prod": "npm run prebuild:prod && tsc --project tsconfig.json && npm run copy-assets",
    "build": "npm run prebuild && tsc --project tsconfig.json && npm run copy-assets",
    "copy-assets": "copyfiles -u 1 \"src/**/*.key\" \"src/**/*.json\" \"src/**/*.yaml\" dist/",
    "dev": "nodemon --exec \"ts-node -r tsconfig-paths/register\" src/preloader.ts",
    "dev:debug": "nodemon --inspect --exec \"ts-node -r tsconfig-paths/register\" src/preloader.ts",
    "debug": "ts-node -r tsconfig-paths/register src/preloader.ts",
    "debug:inspect": "node --inspect-brk -r ts-node/register -r tsconfig-paths/register src/preloader.ts",
    "start": "node dist/preloader.js",
    "validate-config": "ts-node -r tsconfig-paths/register scripts/validate-config.ts",
    "generate:docs": "ts-node -r tsconfig-paths/register src/infrastructure/docs/swagger/index.ts",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API Partner with TypeScript, Express and Hexagonal Architecture",
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@fireblocks/ts-sdk": "^12.1.1",
    "@types/pg": "^8.15.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.12.15",
    "class-transformer": "^0.5.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.0",
    "express-validator": "^7.2.1",
    "hawk": "^9.0.2",
    "inversify": "^6.2.2",
    "inversify-express-utils": "^6.5.0",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "module-alias": "^2.2.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "request": "^2.88.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid4": "^2.0.3"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.23.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/hawk": "^9.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^24.3.0",
    "@types/reflect-metadata": "^0.0.5",
    "@types/request": "^2.48.13",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid4": "^2.0.3",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "_moduleAliases": {
    "@": "dist/",
    "@domain": "dist/domain",
    "@infrastructure": "dist/infrastructure",
    "@application": "dist/application",
    "@bvnk": "dist/infrastructure/third-party/bvnk/.bvnk"
  }
}